# Copy to .env and replace every value. Never commit .env. In production these come from
# HashiCorp Vault or AWS Secrets Manager (see infra/helm and infra/terraform), not from files.
#
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ----- API & worker -------------------------------------------------------------------------
CC_ENV=dev
CC_LOG_LEVEL=INFO
# >= 32 random bytes. Rotation: move the current value to CC_JWT_PREVIOUS_SECRET, set a new one.
CC_JWT_SECRET=replace-with-48-random-url-safe-characters-xxxxxxxxxx
CC_JWT_KID=v1
#CC_JWT_PREVIOUS_SECRET=
#CC_JWT_PREVIOUS_KID=v0

# docker-compose builds CC_DATABASE_URL, CC_REDIS_URL and the S3 endpoint/credentials from the
# infrastructure passwords below. Outside compose, set them directly:
#CC_DATABASE_URL=postgresql+asyncpg://ciphercompute:PASSWORD@localhost:5432/ciphercompute
#CC_REDIS_URL=redis://:PASSWORD@localhost:6379/0
#CC_S3_ENDPOINT_URL=http://localhost:9000

CC_S3_BUCKET=ciphercompute
CC_S3_REGION=us-east-1
# AES256 (SSE-S3) locally; aws:kms with CC_S3_KMS_KEY_ID in AWS.
CC_S3_SSE=AES256
#CC_S3_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/...

CC_CORS_ORIGINS=https://app.localhost:8443
CC_TRUST_X_FORWARDED_FOR=true
CC_RATE_LIMIT_PER_MINUTE=600
CC_LOGIN_RATE_LIMIT_PER_MINUTE=10
CC_TENANT_MAX_CONCURRENT_JOBS=4
CC_ALLOW_SELF_REGISTRATION=true
CC_RUN_MIGRATIONS=0

# OpenTelemetry (optional): docker compose --profile observability
#CC_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# ----- infrastructure (docker-compose only) ----------------------------------------------------
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=ciphercompute
MINIO_ROOT_PASSWORD=replace-me-at-least-8-chars
# 32 random bytes, base64: openssl rand -base64 32  (enables MinIO server-side encryption)
MINIO_KMS_SECRET_KEY=ciphercompute-key:replace-with-base64-32-bytes
GRAFANA_ADMIN_PASSWORD=replace-me

# ----- dashboard -------------------------------------------------------------------------------
CC_API_URL=http://api:8000
